# MySQL配置（统一使用root用户）
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=auth_db
MYSQL_PORT=3306

# 服务端口
SERVICE_PORT=8000

# phpMyAdmin端口
PHPMYADMIN_PORT=8080

# 管理员账户（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT配置
SECRET_KEY=your-secret-key-change-in-production-12345678
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 默认产品 Client Secret（心跳加解密；未登记 software_name 的设备走默认产品策略）
CLIENT_SECRET=your-client-secret-key-change-in-production

# 公网访问根地址（生产环境必填）
# 用于自动生成易支付回调、支付结果页跳转，以及后台展示对外支付页 /pay
# 示例：https://auth.example.com
PUBLIC_BASE_URL=

# 易支付（也可在后台「易支付」页面配置；留空 notify/return 时由 PUBLIC_BASE_URL 自动生成）
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=
EPAY_NOTIFY_URL=
EPAY_RETURN_URL=
